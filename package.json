{
  "name": "room-mapper",
  "version": "1.0.0",
  "description": "Environment and room tracking for Lumiverse roleplay",
  "type": "module",
  "scripts": {
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser --minify",
    "typecheck": "tsc --noEmit",
    "dev": "bun run build",
    "watch": "bun run build --watch"
  },
  "dependencies": {
    "cytoscape": "^3.30.2",
    "lumiverse-spindle-types": "*"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.8",
    "typescript": "^7.0.2"
  }
}
